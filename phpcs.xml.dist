<?xml version="1.0"?>
<ruleset name="BoxMetric">
	<description>WordPress Coding Standards and PHP compatibility for BoxMetric.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<!-- Development scripts, not shipped. -->
	<exclude-pattern>/bin/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.7"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="boxmetric-moving-storage-volume-calculator"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="msvcalc"/>
			</property>
		</properties>
	</rule>

	<!-- index.asset.php is the name WordPress expects for block asset files. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/blocks/*/index.asset.php</exclude-pattern>
	</rule>
</ruleset>
