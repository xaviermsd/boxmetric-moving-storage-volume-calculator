{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "msvcalc/calculator",
	"version": "1.0.1",
	"title": "BoxMetric Volume Calculator",
	"category": "widgets",
	"icon": "calculator",
	"description": "A room-by-room moving volume calculator in cubic feet or cubic metres, with truck, container and storage unit sizes and a quote form.",
	"keywords": [ "moving", "removals", "storage", "volume", "cubic feet", "moving quote", "truck" ],
	"textdomain": "boxmetric-moving-storage-volume-calculator",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"intro": {
			"type": "string",
			"default": ""
		},
		"accent": {
			"type": "string",
			"default": ""
		},
		"units": {
			"type": "string",
			"enum": [ "", "m3", "ft3" ],
			"default": ""
		},
		"theme": {
			"type": "string",
			"enum": [ "", "light", "dark", "auto" ],
			"default": ""
		},
		"showQuote": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css"
}
